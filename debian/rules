#!/usr/bin/make -f
# -*- makefile -*-
# Sample debian/rules that uses debhelper.
# This file was originally written by Joey Hess and Craig Small.
# As a special exception, when this file is copied by dh-make into a
# dh-make output file, you may use that output file without restriction.
# This special exception was added by Craig Small in version 0.37 of dh-make.

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

# The pkg.qemu-server.lsbservice build profile is for Devuan and other
# systemd-free Debian derivatives (see pve-common's and pve-manager's
# pkg.*.lsbservice profiles): it installs LSB init scripts for qmeventd and
# pve-query-machine-capabilities instead of the systemd units, and no
# pve-dbus-vmstate@ unit, as the helper is started directly without it. To build
# this variant, run:
#   dpkg-buildpackage -b -us -uc -Ppkg.qemu-server.lsbservice
ifneq (,$(filter pkg.qemu-server.lsbservice,$(DEB_BUILD_PROFILES)))
export PVE_INIT_SYSTEM = lsbservice
else
export PVE_INIT_SYSTEM = systemd
endif

%:
	dh $@

# lsbservice:Depends: what only the lsbservice variant's code needs, e.g.
# PVE::InitSystem::remove_empty_scope (see vm_stop_cleanup), which only the
# LSBService backend of libpve-common-perl has
ifeq ($(PVE_INIT_SYSTEM),lsbservice)
override_dh_gencontrol:
	dh_gencontrol -- '-Vlsbservice:Depends=libpve-common-perl (>= 9.2.3+devuan4)'
else
override_dh_gencontrol:
	dh_gencontrol -- -Vlsbservice:Depends=
endif

ifeq ($(PVE_INIT_SYSTEM),lsbservice)
override_dh_installinit:
	dh_installinit -pqemu-server --name qmeventd
	dh_installinit -pqemu-server --name pve-query-machine-capabilities --no-stop-on-upgrade

override_dh_lintian:
	dh_lintian
	install -d debian/qemu-server/usr/share/lintian/overrides
	cat debian/qemu-server.lintian-overrides.lsbservice \
	    >>debian/qemu-server/usr/share/lintian/overrides/qemu-server
endif
