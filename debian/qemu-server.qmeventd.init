#!/bin/sh
### BEGIN INIT INFO
# Provides:          qmeventd
# Required-Start:    $local_fs $syslog
# Required-Stop:     $local_fs $syslog
# X-Start-Before:    pve-ha-lrm pve-guests
# X-Stop-After:      pve-ha-lrm pve-guests
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: PVE Qemu Event Daemon
### END INIT INFO

# LSB counterpart of qmeventd.service, only installed by the
# pkg.qemu-server.lsbservice build (see debian/rules). Like the unit, it starts
# before and stops after pve-ha-lrm and pve-guests, so that it handles the
# events of guests stopped at shutdown. qmeventd daemonizes itself and doesn't
# write a pid file, so it's found by its executable. Its daemon(0, 1) keeps
# stdin, the console at boot, so it's started with stdin from /dev/null, as
# the unit's.

. /lib/lsb/init-functions

NAME=qmeventd
DESC="PVE Qemu Event Daemon"
DAEMON=/usr/sbin/qmeventd
SOCKET=/var/run/qmeventd.sock

test -x $DAEMON || exit 0

do_stop() {
    start-stop-daemon --stop --quiet --oknodo --retry TERM/10/KILL/5 --exec $DAEMON
}

case "$1" in
    start)
        log_daemon_msg "Starting $DESC" "$NAME"
        start-stop-daemon --start --quiet --oknodo --exec $DAEMON -- $SOCKET </dev/null
        log_end_msg $?
        ;;
    stop)
        log_daemon_msg "Stopping $DESC" "$NAME"
        do_stop
        log_end_msg $?
        ;;
    restart|force-reload)
        log_daemon_msg "Restarting $DESC" "$NAME"
        do_stop && start-stop-daemon --start --quiet --exec $DAEMON -- $SOCKET </dev/null
        log_end_msg $?
        ;;
    status)
        status_of_proc $DAEMON $NAME
        ;;
    *)
        echo "Usage: /etc/init.d/$NAME {start|stop|restart|force-reload|status}" >&2
        exit 3
        ;;
esac
